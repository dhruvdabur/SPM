<?xml version="1.0" encoding="UTF-8"?>

<mujoco model="closed_loop_test">

    <option gravity="0 0 0"
            timestep="0.002"/>

    <worldbody>

        <!-- ============================= -->
        <!-- BASE                           -->
        <!-- ============================= -->

        <body name="base">

            <geom type="box"
                  size="0.3 0.3 0.02"
                  rgba="0.5 0.5 0.5 1"/>


            <!-- ========================= -->
            <!-- BLUE LINK 1                -->
            <!-- ========================= -->

            <body name="blue1"
                  pos="-0.15 0 0.05">

                <joint name="q1"
                       type="hinge"
                       axis="0 1 0"/>

                <geom type="capsule"
                      fromto="0 0 0 0 0 0.25"
                      size="0.025"
                      rgba="0 0 1 1"/>

                <site name="blue1_end"
                      pos="0 0 0.25"
                      size="0.02"
                      rgba="0 1 0 1"/>

            </body>


            <!-- ========================= -->
            <!-- BLUE LINK 2                -->
            <!-- ========================= -->

            <body name="blue2"
                  pos="0 0 0.05">

                <joint name="q2"
                       type="hinge"
                       axis="0 1 0"/>

                <geom type="capsule"
                      fromto="0 0 0 0 0 0.25"
                      size="0.025"
                      rgba="0 0 1 1"/>

                <site name="blue2_end"
                      pos="0 0 0.25"
                      size="0.02"
                      rgba="0 1 0 1"/>

            </body>


            <!-- ========================= -->
            <!-- BLUE LINK 3                -->
            <!-- ========================= -->

            <body name="blue3"
                  pos="0.15 0 0.05">

                <joint name="q3"
                       type="hinge"
                       axis="0 1 0"/>

                <geom type="capsule"
                      fromto="0 0 0 0 0 0.25"
                      size="0.025"
                      rgba="0 0 1 1"/>

                <site name="blue3_end"
                      pos="0 0 0.25"
                      size="0.02"
                      rgba="0 1 0 1"/>

            </body>

        </body>


        <!-- ============================= -->
        <!-- COMMON TOP PLATE (top-level)   -->
        <!-- ============================= -->

        <body name="top_plate"
              pos="0 0 0.30">

            <freejoint/>

            <geom type="box"
                  size="0.25 0.08 0.02"
                  rgba="1 0 0 1"/>

            <site name="plate1"
                  pos="-0.15 0 0"
                  size="0.02"
                  rgba="1 1 0 1"/>

            <site name="plate2"
                  pos="0 0 0"
                  size="0.02"
                  rgba="1 1 0 1"/>

            <site name="plate3"
                  pos="0.15 0 0"
                  size="0.02"
                  rgba="1 1 0 1"/>

        </body>

    </worldbody>


    <!-- =============================================== -->
    <!-- CLOSED LOOP CONSTRAINTS                         -->
    <!-- =============================================== -->

    <equality>

        <connect
            name="connection1"
            site1="blue1_end"
            site2="plate1"/>

        <connect
            name="connection2"
            site1="blue2_end"
            site2="plate2"/>

        <connect
            name="connection3"
            site1="blue3_end"
            site2="plate3"/>

    </equality>

</mujoco>
